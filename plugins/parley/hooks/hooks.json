            "command": "node \"${CLAUDE_PLUGIN_ROOT}/parley.mjs\" hook SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
